! Verb continuation classes. Endings reflect the existing lemmatizer;
! their person and number are not specified where that code did not specify them.
Multichar_Symbols
+Present +PresentAdverb +Past1 +Past2 +Past3 +Past4 +Past5
+Future +Vhan +VhanAuxiliary +Auxiliary +Imperative +VerbAdverb +VerbEko +Plural
+VerbFormE +VerbFormEt +PastParticiple
+Subject +DirectObject +DefiniteSubject +NumeralBase
%^Present %^Past %^Base %^VerbE %^VerbEt %^DropVowel %^DropN

LEXICON Nominal
+Subject:t # ;
+DirectObject:n # ;

LEXICON DefiniteVowel
+DefiniteSubject:%^DropVowel DefiniteEnding ;

LEXICON DefiniteVerb
+DefiniteSubject:%^Base DefiniteEnding ;

LEXICON DefiniteEnding
0:at # ;

LEXICON StativePast
+Past5:%^DropVowel PastFiveEndings ;

LEXICON NumeralBase
+NumeralBase:%^DropN # ;

LEXICON RegularVerb
SharedVerbForms ;
RegularPresent ;
RegularPast ;
RegularFuture ;
RegularVhan ;
RegularVhanAuxiliary ;
RegularAuxiliary ;
RegularImperative ;
RegularPastTwo ;
RegularPastThree ;

LEXICON SingularVerb
SharedVerbForms ;
SingularPresent ;
SingularPast ;
SingularFuture ;
SingularVhan ;
SingularVhanAuxiliary ;
SingularAuxiliary ;
SingularImperative ;
SingularPastTwo ;
SingularPastThree ;

LEXICON PluralVerb
+Plural: PluralVerbForms ;

LEXICON PluralVerbForms
+Present:%^Present PluralPresentEndings ;
+PresentAdverb:%^Present PluralPresentAdverbEndings ;
+Past1:%^Past PluralPastEndings ;
+Future:%^Base PluralFutureEndings ;
+Vhan:%^Base PluralVhanEndings ;
+VhanAuxiliary:%^Base PluralVhanAuxiliaryEndings ;
+Auxiliary:%^Present PluralAuxiliaryEndings ;
+Imperative:%^Base PluralImperativeEndings ;
+Past2:%^Base PluralPastTwoEndings ;
+Past3:%^Base PluralPastThreeEndings ;
+Past4:%^Base PastFourEndings ;
+Past5:%^Base PastFiveEndings ;
+VerbFormEt:%^VerbEt # ;
+PastParticiple:%^Past PastParticipleEnding ;

LEXICON SharedVerbForms
+Past4:%^Base PastFourEndings ;
+Past5:%^Base PastFiveEndings ;
+VerbAdverb:%^Base VerbAdverbEndings ;
+VerbEko:%^Base VerbEkoEnding ;
+VerbFormE:%^VerbE # ;
+VerbFormEt:%^VerbEt # ;
+PastParticiple:%^Past PastParticipleEnding ;

LEXICON RegularPresent
+Present:%^Present PresentEndings ;
+PresentAdverb:%^Present PresentAdverbEndings ;

LEXICON SingularPresent
+Present:%^Present SingularPresentEndings ;
+PresentAdverb:%^Present SingularPresentAdverbEndings ;

LEXICON RegularPast
+Past1:%^Past PastEndings ;

LEXICON SingularPast
+Past1:%^Past SingularPresentEndings ;

LEXICON RegularFuture
+Future:%^Base FutureEndings ;

LEXICON SingularFuture
+Future:%^Base SingularFutureEndings ;

LEXICON RegularVhan
+Vhan:%^Base VhanEndings ;

LEXICON SingularVhan
+Vhan:%^Base SingularVhanEndings ;

LEXICON RegularVhanAuxiliary
+VhanAuxiliary:%^Base VhanAuxiliaryEndings ;

LEXICON SingularVhanAuxiliary
+VhanAuxiliary:%^Base SingularVhanAuxiliaryEndings ;

LEXICON RegularAuxiliary
+Auxiliary:%^Present AuxiliaryEndings ;

LEXICON SingularAuxiliary
+Auxiliary:%^Present SingularAuxiliaryEndings ;

LEXICON RegularImperative
+Imperative:%^Base ImperativeEndings ;

LEXICON SingularImperative
+Imperative:%^Base SingularImperativeEndings ;

LEXICON RegularPastTwo
+Past2:%^Base PastTwoEndings ;

LEXICON SingularPastTwo
+Past2:%^Base SingularPastTwoEndings ;

LEXICON RegularPastThree
+Past3:%^Base PastThreeEndings ;

LEXICON SingularPastThree
+Past3:%^Base SingularPastThreeEndings ;

